{
  "name": "clinica-pipo-site",
  "private": true,
  "version": "1.0.0",
  "description": "Site estático da Clínica de Autismo Pipo. O blog é escrito em Markdown (content/blog) e este script gera as páginas HTML finais.",
  "scripts": {
    "build:blog": "node scripts/build-blog.js",
    "build:minify": "esbuild css/styles.css --minify --allow-overwrite --outfile=css/styles.css && esbuild js/script.js --minify --allow-overwrite --outfile=js/script.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  }
}
